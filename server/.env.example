PORT=5001
MONGO_URI=
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:3002
# Profile: development | demo | production. Independent of NODE_ENV.
APP_ENV=development
# Demo sign-in bridge (POST /api/auth/demo-session). Works only with APP_ENV=development|demo.
# FINAL PRODUCTION: keep false (and APP_ENV=production, which refuses it outright).
ENABLE_DEMO_AUTH=false
